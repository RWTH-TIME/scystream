# see docs/deployment/env-reference.md
DEVELOPMENT=false
EXTERNAL_URL=https://app.example.org
LOG_LEVEL=INFO

DATABASE_HOST=db.internal
DATABASE_NAME=core
DATABASE_USER=core
DATABASE_PASSWORD=change-me

KEYCLOAK_SERVER_URL=https://auth.example.org
KEYCLOAK_REALM=main
KEYCLOAK_CLIENT_ID=scystream-core
KEYCLOAK_CLIENT_SECRET=secret-of-the-scystream-core-client

AIRFLOW_HOST=http://airflow.internal:8080
AIRFLOW_USER=scystream
AIRFLOW_PASS=change-me

WORKFLOW_TEMPLATE_REPO=https://git.example.org/org/pipeline-templates.git

CB_NETWORK_MODE=bridge
CB_IMAGE_FORCE_PULL=true
CB_IMAGE_REGISTRY_MIRRORS={"ghcr.io":"localhost:5001"}

DEFAULT_CB_CONFIG_PG_HOST=db.internal
DEFAULT_CB_CONFIG_PG_PORT=5432
DEFAULT_CB_CONFIG_PG_DB=data
DEFAULT_CB_CONFIG_PG_USER=scystream_data
DEFAULT_CB_CONFIG_PG_PASS=change-me

DEFAULT_CB_CONFIG_S3_HOST=https://s3.example.org
DEFAULT_CB_CONFIG_S3_PORT=443
DEFAULT_CB_CONFIG_S3_ACCESS_KEY=scystream
DEFAULT_CB_CONFIG_S3_SECRET_KEY=change-me
DEFAULT_CB_CONFIG_S3_BUCKET_NAME=data
DEFAULT_CB_CONFIG_S3_FILE_PATH=/
EXTERNAL_URL_DATA_S3=https://s3.example.org
MAX_UPLOAD_SIZE_MB=100

SUPERSET_HOST=https://superset.example.org
SUPERSET_PUBLIC_URL=https://superset.example.org
SUPERSET_KEYCLOAK_CLIENT_ID=superset-service
SUPERSET_KEYCLOAK_CLIENT_SECRET=secret-of-the-superset-service-client
SUPERSET_DATA_SQLALCHEMY_URI=postgresql+psycopg2://superset_reader:change-me@db.internal:5432/data
